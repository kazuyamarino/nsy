{
    "name": "vikry/nsy",
    "description": "Simple. Layered. Harmony in MVC and HMVC.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Vikry Yuansah",
            "email": "admin@nsyframework.com"
        }
    ],
    "require": {
        "nesbot/carbon": "^2.53.1",
        "voku/anti-xss": "^4.1",
        "rakit/validation": "^1.4",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "System\\": "System/"
        },
        "files": [
            "System/Helpers/CodeIgniterHelpers.php"
        ]
    },
    "config": {
        "vendor-dir": "System/Vendor/",
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "composer dump-autoload -o",
            "@nsy_cli_install"
        ],
        "nsy_cli_install": [
            "bash INSTALL.sh"
        ],
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "lint:full": "php-cs-fixer fix --config=.php-cs-fixer.full.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
