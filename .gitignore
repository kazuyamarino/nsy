# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files

/env.php
/.htaccess
/.phpunit.result.cache
/.php-cs-fixer.cache
/.php-cs-fixer.php
/MIGRATIONLOG
public/.htaccess

# Composer dependencies (restored with `composer install`; not committed)
System/Vendor/

# Test-only artifacts (CRUD reference: query builder vs plain DB) — delete before production
System/Apps/General/Controllers/C_Test_*.php
System/Apps/General/Models/M_Test_*.php
System/Routes/Test_CRUD.php

# Razr compiled template cache (generated at runtime)
System/Apps/Templates/razr_cache/

# Application logs (runtime - dont commit)
System/Storage/logs/*
!System/Storage/logs/.htaccess
# Maintenance mode flag (runtime - toggled by `nsy down` / `nsy up`)
System/Storage/maintenance.flag
# Rate-limit counters (runtime)
System/Storage/ratelimit/*

# AI Agents local cache
/.gitnexus/
/.claude/

# AI planning docs (working ledger, generated per session)
docs/plans/

# AI local configurations (opsional, but recommended to ignore to avoid conflicts with the team)
/opencode.json
/.opencodeignore

# OS & Editor Config
.DS_Store
.idea/
.vscode/
*.swp

# AI Agent Configurations
AGENTS.md
CLAUDE.md
