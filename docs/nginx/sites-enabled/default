autoindex off;

# If APP_DIR (env.php) != 'nsy' or PUBLIC_DIR != 'public', update paths below
# e.g. APP_DIR => 'myapp', PUBLIC_DIR => 'my_public' then: /myapp/my_public/...
error_page 404 /nsy/public/404.html;
error_page 403 /nsy/public/403.html;
error_page 500 502 503 504 /nsy/public/50x.html;

location /nsy/ {
	# First attempt to serve request as file, then
	# as directory, then fall back to displaying a 404.
	try_files $uri /nsy/public/index.php?/$uri;
}

# Deny direct web access to framework internals and logs.
# Placed BEFORE the /nsy/ block (^~ prefix wins over the plain prefix match).
location ^~ /nsy/System/ {
	deny all;
	return 404;
}
